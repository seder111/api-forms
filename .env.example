APP_DEBUG=false
CONTACT_SUCCESS_URL=/gracias/
CONTACT_ERROR_URL=/contacto/?error=validation

# Credenciales de Plunk para el email de notificación.
PLUNK_API_KEY=
PLUNK_FROM=
PLUNK_NAME_FROM=
CONTACT_RECIPIENT=

# Nombres de los campos especiales del formulario. El campo de email
# identifica al remitente (siempre obligatorio); la casilla de newsletter
# (value="1") determina la suscripción en Plunk. Vacío = "email"/"newsletter".
CONTACT_EMAIL_FIELD=email
CONTACT_NEWSLETTER_FIELD=newsletter

# Campos obligatorios además del email, separados por comas. Una casilla
# obligatoria (ej. la de privacidad) también vale: marcada envía "1".
CONTACT_REQUIRED_FIELDS=name,privacy

# Casillas que en el email de notificación se muestran como Sí/No.
CONTACT_CHECKBOX_FIELDS=privacy,newsletter

# Opcional. Asunto del email de notificación; {campo} se sustituye por el
# valor de ese campo, ej. "Nuevo mensaje de {name}". Si se deja vacío se usa
# "New contact message from <email>".
CONTACT_EMAIL_SUBJECT=

# Enviar el email de notificación por cada envío. Activado por defecto:
# solo PLUNK_SEND_EMAIL=false lo desactiva (ej. despliegues que solo
# guardan contactos en Plunk).
# PLUNK_SEND_EMAIL=false

# Guardar los remitentes como contactos en Plunk (newsletter). Opt-in:
# sin esta variable o con false, solo se envía el email de notificación.
# PLUNK_SAVE_CONTACTS=true

# Campos del formulario que se guardan en el contacto de Plunk, separados
# por comas. Sintaxis "campo" o "campo:claveEnPlunk" para guardarlo con otro
# nombre, ej. "name,phone:telefono". Vacío = solo email y suscripción.
PLUNK_CONTACT_FIELDS=name

# Guardar cada envío en una base de datos propia (tabla "submissions",
# creada automáticamente). Opcional y opt-in: sin esta variable o con
# false no se conecta ni se guarda nada.
# DB_SAVE_SUBMISSIONS=true

# Driver: "mysql" (también MariaDB; es el valor por defecto) o "sqlite".
DB_DRIVER=mysql

# Conexión mysql/mariadb.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Solo sqlite. Ruta relativa a la carpeta de la app (siempre fuera del
# webroot público); vacío = storage/database.sqlite
DB_SQLITE_PATH=
